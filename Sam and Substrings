def substrings(n):
    # Write your code here
    modulo = int(1e9 + 7)
    result = sub_sum = int(n[0])

    for digit_idx in range(1, len(n)):
        digit = int(n[digit_idx])
        digit_presence = digit_idx + 1
        sub_sum = (sub_sum * 10 + digit * digit_presence) % modulo
        result = (result + sub_sum) % modulo

    return result
